# Copie para .env.local e ajuste. Nada aqui é obrigatório: sem chaves o site já funciona
# com o MCP da Kiwi.com (voos), o Xotelo (hotéis), o Wikimedia (fotos) e o Frankfurter (câmbio).

# URL pública do site (usada nos links que o servidor MCP devolve).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Voos -------------------------------------------------------------------
# Servidor MCP público da Kiwi.com (Streamable HTTP, sem chave).
KIWI_MCP_URL=https://mcp.kiwi.com
KIWI_MCP_ENABLED=true

# --- Hotéis -----------------------------------------------------------------
# Xotelo: catálogo do TripAdvisor + diárias por site (Booking, Expedia, Agoda…). Sem chave.
XOTELO_ENABLED=true
XOTELO_LOCATION_KEY=g60763

# LiteAPI (Nuitee): galeria de fotos, estrelas, comodidades. Chave sandbox grátis em https://dashboard.liteapi.travel
LITEAPI_KEY=

# SerpApi: Google Hotels + Google Flights (plano grátis com cota mensal). https://serpapi.com/manage-api-key
SERPAPI_KEY=

# --- Fotos (Wikimedia) ------------------------------------------------------
# Contato no User-Agent, como pede a política do Wikimedia (URL do projeto ou e-mail).
WIKIMEDIA_CONTACT=https://github.com/lleonardo-franco/nyc-travel-search
# Opcional: token OAuth 2.0 pessoal (https://api.wikimedia.org/wiki/Special:AppManagement)
# para limites de usuário autenticado. Sem ele, o servidor usa a cota anônima e, se for
# limitado (HTTP 429), o navegador do visitante busca as fotos diretamente.
WIKIMEDIA_ACCESS_TOKEN=

# --- Mapa -------------------------------------------------------------------
# Tiles do OpenStreetMap por padrão (uso leve). Para tráfego alto, use um provedor com chave:
# NEXT_PUBLIC_MAP_TILES=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=SUA_CHAVE
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap
NEXT_PUBLIC_MAP_TILES=

# --- Comportamento -----------------------------------------------------------
# off: nunca usa dados fictícios | fallback: só se todas as fontes falharem | only: só demo (offline)
DEMO_MODE=fallback
# Buscas por minuto por IP em /api/* (protege as APIs públicas usadas).
RATE_LIMIT_PER_MINUTE=60
